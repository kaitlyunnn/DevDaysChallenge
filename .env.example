# EXPO_PUBLIC_* is bundled into the app and readable by anyone who installs it.
# Treat everything with that prefix as public. Secrets go below, without it.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Absolute URL the native app calls for /api. Leave blank for web (same-origin).
# e.g. https://devdayschallenge.vercel.app
EXPO_PUBLIC_API_URL=

# --- Server-only, used by /api functions. Never prefixed with EXPO_PUBLIC_. ---
SUPABASE_URL=https://your-project.supabase.co
# Bypasses Row Level Security.
SUPABASE_SECRET_KEY=your-secret-key
GEMINI_API_KEY=your-gemini-api-key
